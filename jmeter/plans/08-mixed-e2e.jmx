<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="08 Mixed E2E Delivery" enabled="true">
      <stringProp name="TestPlan.comments">混合场景端到端投递可靠性测试
策略: 同时有私聊和群聊流量, 发送者发消息, 接收者读消息并验证, 对比 sent vs received
私聊: 发送者不会收到自己发的消息推送 (私聊只推 toUserId)
群聊: 发送者不会收到自己发的消息推送 (服务端跳过 senderId)
验证: 接收方检查收到的消息包含唯一 msgTag, 记录到 props 计数器
目标: 私聊约 6K msg/s + 单群约 100 group msg/s 的混合 E2E
参数:
  私聊: -JpvtSendThreads=300 -JpvtRecvThreads=150 -JpvtSendDelayMs=50
  群聊: -JgrpSendThreads=50 -JgrpRecvThreads=50 -JgrpSendDelayMs=500
  公共: -Jduration=90 -JwarmupMs=10000 -JrecvDuration=120
私聊 300x20=6000 msg/s + 群聊 50x2=100 group msg/s 理论发送
扇出可观测值受 JMeter 接收窗口限制
投递率 = (pvtReceived + grpReceived) / (pvtSent + grpSent * grpRecvThreads) * 100%</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>

      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Init Counters" enabled="true">
          <stringProp name="cacheKey">mix-e2e-init</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.concurrent.atomic.AtomicInteger;
import java.util.concurrent.atomic.AtomicLong;

props.put('mix.pvtSent', new AtomicInteger(0));
props.put('mix.pvtReceived', new AtomicInteger(0));
props.put('mix.grpSent', new AtomicInteger(0));
props.put('mix.grpReceived', new AtomicInteger(0));
props.put('mix.recvErrors', new AtomicInteger(0));
props.put('mix.startTime', new AtomicLong(System.currentTimeMillis()));

log.info('[MIX-E2E] Counters initialized');
SampleResult.setResponseData('MIX E2E counters initialized', 'UTF-8');</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Private Senders" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(pvtSendThreads,200)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(pvtSendRamp,20)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,180)}</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <stringProp name="LoopController.loops">-1</stringProp>
          <boolProp name="LoopController.continue_forever">true</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="e2e-private-senders.csv" enabled="true">
          <stringProp name="filename">${__P(data.dir,../data)}/e2e-private-senders.csv</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">sSenderId,sReceiverId,sToken</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">true</boolProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>

        <eu.luminis.jmeter.wssampler.OpenWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.OpenWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.OpenWebSocketSampler" testname="Pvt Sender Connect" enabled="true">
          <stringProp name="server">${__P(host,localhost)}</stringProp>
          <stringProp name="port">${__P(wsport,8081)}</stringProp>
          <stringProp name="path">/ws</stringProp>
          <stringProp name="connectTimeout">15000</stringProp>
          <stringProp name="readTimeout">15000</stringProp>
          <stringProp name="connectionId">mix-ps-${__threadNum}</stringProp>
        </eu.luminis.jmeter.wssampler.OpenWebSocketSampler>
        <hashTree/>

        <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="Pvt Sender Auth" enabled="true">
          <stringProp name="dataType">Text</stringProp>
          <stringProp name="requestData">{"type":"auth","token":"${sToken}","deviceId":"mixPS_${sSenderId}"}</stringProp>
          <stringProp name="connectionId">mix-ps-${__threadNum}</stringProp>
        </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
        <hashTree/>

        <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="Pvt Sender Auth Resp" enabled="true">
