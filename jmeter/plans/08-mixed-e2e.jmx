          </ResponseAssertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Init Hb Timer" enabled="true">
            <stringProp name="cacheKey">mix-gr-init-hb</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">vars.putObject('lastHbTime', System.currentTimeMillis());</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>

        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Grp Recv Loop" enabled="true">
          <stringProp name="LoopController.loops">-1</stringProp>
          <boolProp name="LoopController.continue_forever">true</boolProp>
        </LoopController>
        <hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Heartbeat Check" enabled="true">
            <stringProp name="IfController.condition">${__groovy(System.currentTimeMillis() - (vars.getObject('lastHbTime') ?: 0L) > 30000L)}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="Send Heartbeat" enabled="true">
              <stringProp name="dataType">Text</stringProp>
              <stringProp name="requestData">{"type":"heartbeat"}</stringProp>
              <stringProp name="connectionId">mix-gr-${__threadNum}</stringProp>
            </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
            <hashTree>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Update Hb Timer" enabled="true">
                <stringProp name="cacheKey">mix-gr-update-hb</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">vars.putObject('lastHbTime', System.currentTimeMillis());</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
          </hashTree>

          <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="Recv Group Msg" enabled="true">
            <stringProp name="dataType">Text</stringProp>
            <stringProp name="readTimeout">${__P(recvReadTimeout,3000)}</stringProp>
            <stringProp name="connectionId">mix-gr-${__threadNum}</stringProp>
          </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Validate + Count" enabled="true">
              <stringProp name="cacheKey">mix-grp-recv-validate</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def response = prev.getResponseDataAsString();
if (response == null || response.isEmpty()) {
    Thread.sleep(200);
    return;
}
if (response.contains('e2e-mix-grp')) {
    def counter = props.get('mix.grpReceived');
    if (counter != null) { counter.incrementAndGet(); }
}
// Update heartbeat timer on any successful read
vars.putObject('lastHbTime', System.currentTimeMillis());</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>

        <eu.luminis.jmeter.wssampler.CloseWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.CloseWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.CloseWebSocketSampler" testname="Grp Receiver Close" enabled="true">
          <stringProp name="statusCode">1000</stringProp>
          <stringProp name="readTimeout">3000</stringProp>
          <stringProp name="connectionId">mix-gr-${__threadNum}</stringProp>
        </eu.luminis.jmeter.wssampler.CloseWebSocketSampler>
        <hashTree/>
      </hashTree>

      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="tearDown" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </PostThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Drain Wait" enabled="true">
          <stringProp name="cacheKey">mix-e2e-drain</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def drainSec = Integer.parseInt(props.getProperty('drainSec', '20'));
log.info('[MIX-E2E] Waiting {} seconds for pipeline to drain ...', drainSec);
Thread.sleep(drainSec * 1000L);
SampleResult.setResponseData("Drained ${drainSec}s", 'UTF-8');
SampleResult.setSuccessful(true);</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="MIX E2E Delivery Report" enabled="true">
          <stringProp name="cacheKey">mix-e2e-report</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.concurrent.atomic.AtomicInteger;

def pvtSent = ((AtomicInteger) props.get('mix.pvtSent')).get();
def pvtReceived = ((AtomicInteger) props.get('mix.pvtReceived')).get();
def grpSent = ((AtomicInteger) props.get('mix.grpSent')).get();
def grpReceived = ((AtomicInteger) props.get('mix.grpReceived')).get();
def recvErrors = ((AtomicInteger) props.get('mix.recvErrors')).get();

def numGrpReceivers = Integer.parseInt(props.getProperty('grpRecvThreads', '50'));
def pvtRate = pvtSent > 0 ? String.format('%.2f', pvtReceived * 100.0 / pvtSent) : 'N/A';
def grpExpected = (long) grpSent * numGrpReceivers;
def grpRate = grpExpected > 0 ? String.format('%.2f', grpReceived * 100.0 / grpExpected) : 'N/A';
def totalSent = pvtSent + grpSent;
def totalExpected = pvtSent + grpExpected;
def totalRate = totalExpected > 0 ? String.format('%.2f', (pvtReceived + grpReceived) * 100.0 / totalExpected) : 'N/A';

def report = """
============================================
  Mixed E2E Delivery Report
============================================
  --- Private Chat ---
  Messages Sent:       ${pvtSent}
  Messages Received:   ${pvtReceived}
  Delivery Rate:       ${pvtRate}%

  --- Group Chat ---
  Messages Sent:       ${grpSent}
  Messages Received:   ${grpReceived}
  Expected Deliveries: ${grpExpected} (${grpSent} x ${numGrpReceivers} receivers)
  Delivery Rate:       ${grpRate}%

  --- Combined ---
  Total Sent:          ${totalSent}
  Total Expected:      ${totalExpected}
  Total Received:      ${pvtReceived + grpReceived}
  Overall Rate:        ${totalRate}%
  Recv Timeouts:       ${recvErrors}
============================================
""";

log.info(report);
print(report);
SampleResult.setResponseData(report, 'UTF-8');
SampleResult.setSuccessful(true);
def outDir = new File(System.getProperty('user.dir') + '/jmeter/results');
if (!outDir.exists()) outDir.mkdirs();
new File(outDir, '08-mixed-e2e-report.txt').write(report);</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time><latency>true</latency><timestamp>true</timestamp><success>true</success>
            <label>true</label><code>true</code><message>true</message><threadName>true</threadName>
            <dataType>true</dataType><assertions>true</assertions><subresults>true</subresults>
            <responseData>false</responseData><fieldNames>true</fieldNames>
            <bytes>true</bytes><sentBytes>true</sentBytes><url>true</url>
            <threadCounts>true</threadCounts><connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename"></stringProp>
      </ResultCollector>
      <hashTree/>

    </hashTree>
  </hashTree>
</jmeterTestPlan>
